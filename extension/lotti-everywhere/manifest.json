{
  "manifest_version": 3,
  "name": "Lotti - Lofty Support Assistant",
  "description": "Lotti, the Lofty Support Portal assistant, on your work tabs: click the robot (or press Alt+L) to ask about SOPs, announcements, HR policy and past tickets without leaving Zendesk, Jira or the CRM.",
  "version": "1.1.0",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open Lotti",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "alarms"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.zendesk.com/*",
        "https://*.atlassian.net/*",
        "https://*.lofty.com/*",
        "https://*.chime.me/*",
        "https://*.hubspot.com/*",
        "https://*.sharepoint.com/*",
        "https://teams.microsoft.com/*",
        "https://outlook.office.com/*"
      ],
      "exclude_matches": [
        "https://loftysupportportal.com/*",
        "https://*.loftysupportportal.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "commands": {
    "open-lotti": {
      "suggested_key": {
        "default": "Alt+L",
        "mac": "Alt+L"
      },
      "description": "Open Lotti"
    }
  },
  "host_permissions": [
    "https://loftysupportportal.com/*"
  ]
}
